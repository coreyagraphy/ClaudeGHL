# LLM backend selection.
#   "api"        — use ANTHROPIC_API_KEY (billed against your API account)
#   "claude-cli" — use the `claude` CLI (billed against your Claude subscription)
#   unset        — auto: api if ANTHROPIC_API_KEY is set, else claude-cli
# The claude-cli backend requires `claude` on PATH and an active Claude Code login.
LLM_BACKEND=

ANTHROPIC_API_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=
HIGGSFIELD_API_KEY=
GOOGLE_SEARCH_API_KEY=
