# LLM backend selection.
#   "api"        — use ANTHROPIC_API_KEY (billed against your API account)
#   "claude-cli" — use the `claude` CLI (billed against your Claude subscription)
#   unset        — auto: api if ANTHROPIC_API_KEY is set, else claude-cli
# The claude-cli backend requires `claude` on PATH and an active Claude Code login.
LLM_BACKEND=

ANTHROPIC_API_KEY=
GHL_API_KEY=
GHL_LOCATION_ID=
HIGGSFIELD_API_KEY=
GOOGLE_SEARCH_API_KEY=

# GHL pipeline + stage IDs (lookup via GET /opportunities/pipelines once, then paste here).
# Required for ingestion to create opportunities. Without these, ingest will
# create/update the contact + apply tags but skip the opportunity step.
GHL_PIPELINE_ID=
GHL_STAGE_SPRINT=
GHL_STAGE_STAY_FOUND=
GHL_STAGE_FOUNDATION=

# GHL workflow IDs by tier. The score determines which tier-specific workflow
# the contact is enrolled into on ingestion. Tier names here MUST match the
# tier keys in src/context.js — sprint (0-54), stay_found (55-79),
# foundation (80-100). The "diagnostic" $297 lead-in is a separate offer,
# not a score band, so it has no workflow slot.
GHL_WORKFLOW_SPRINT=
GHL_WORKFLOW_STAY_FOUND=
GHL_WORKFLOW_FOUNDATION=
GHL_WORKFLOW_DEFAULT=

# Alternative: point to a JSON file with all the above keys (used as override).
GHL_CONFIG_FILE=
